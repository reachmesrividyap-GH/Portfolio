      "parameters": {
        "jsCode": "const slackEvent = $('Ignore Bot Messages').item.json.body.event;\nconst sheetRows = $('Fetch Google Sheet-Slack').all().map(i => i.json);\nreturn [{\n  json: {\n    userQuestion: slackEvent.text,\n    channelId: slackEvent.channel,\n    threadTs: slackEvent.ts,\n    userId: slackEvent.user,\n    source: 'slack',\n    sheetData: JSON.stringify(sheetRows, null, 2)\n  }\n}];"
      },
