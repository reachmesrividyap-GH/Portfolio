    {
      "parameters": {
        "jsCode": "const events = $('Filter New Events').first().json.events;\nconst baselines = $('Read Baseline Metrics').all().reduce((acc, i) => {\n  acc[i.json.checkout_step] = Number(i.json.baseline_rate);\n  return acc;\n}, {});\n\nconst HIGH_VALUE_THRESHOLD = 1500;\nconst MOBILE_FAILURE_THRESHOLD = 2;\n\nconst byStep = {};\nfor (const e of events) {\n  byStep[e.checkout_step] = byStep[e.checkout_step] || { count: 0, mobile: 0, maxValue: 0, maxValueDevice: null };\n  const s = byStep[e.checkout_step];\n  s.count++;\n  if (e.device === 'MOBILE') s.mobile++;\n  if (e.cart_value > s.maxValue) {\n    s.maxValue = e.cart_value;\n    s.maxValueDevice = e.device;\n  }\n}\n\nconst items = Object.entries(byStep).map(([step, s]) => {\n  const baseline_rate = baselines[step] ?? null;\n  const exceeds_baseline = baseline_rate != null ? s.count > baseline_rate : false;\n\n  const triggered_rules = [];\n  if (step === 'PAYMENT') triggered_rules.push('PAYMENT step (critical revenue impact)');\n  if (s.maxValue > HIGH_VALUE_THRESHOLD) triggered_rules.push(`cart value ${s.maxValue} exceeds ${HIGH_VALUE_THRESHOLD}`);\n  if (exceeds_baseline) triggered_rules.push(`event count ${s.count} exceeds baseline ${baseline_rate}`);\n  if (s.mobile >= MOBILE_FAILURE_THRESHOLD) triggered_rules.push(`${s.mobile} mobile failures (possible app bug)`);\n\n  const step_severity = triggered_rules.length > 0 ? 'HIGH' : 'LOW';\n  const step_action = step_severity === 'HIGH' ? 'ALERT' : 'LOG';\n\n  return {\n    json: {\n      checkout_step: step,\n      event_count: s.count,\n      mobile_failure_count: s.mobile,\n      max_cart_value: s.maxValue,\n      max_cart_value_device: s.maxValueDevice,\n      baseline_rate,\n      exceeds_baseline,\n      triggered_rules,\n      triggered_rules_text: triggered_rules.join('; ') || 'no rules triggered',\n      step_severity,\n      step_action\n    }\n  };\n});\n\nreturn items;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1024,
        96
      ],
      "id": "0a0bfbf8-edc9-4723-8db6-038773695ddd",
      "name": "Aggregate Batch"
