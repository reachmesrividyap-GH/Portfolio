    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const llmOutput = JSON.parse($json.output);\nconst stepData = $('Aggregate Batch').item.json;\n\nconst timestamp = $now.setZone('Asia/Kolkata').toFormat('yyyy-MM-dd HH:mm:ss');\nconst commandId = `CMD_${timestamp.replace(/[-: ]/g, '').slice(0, 14)}_${stepData.checkout_step}`;\n\nreturn {\n  json: {\n    command_id: commandId,\n    action: stepData.step_action,\n    severity: stepData.step_severity,\n    reason: llmOutput.reason,\n    checkout_step: stepData.checkout_step,\n    cart_value: stepData.max_cart_value,\n    device: stepData.max_cart_value_device,\n    baseline_rate: stepData.baseline_rate,\n    timestamp\n  }\n};"
      },
